generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Viaform 1.0 canonical identity and organisation boundary.
// A fresh database contains no organisations, users, memberships, sessions,
// coaching profiles, QA records, demo records, or seeded product data.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String
  profileImageUrl String?
  passwordHash String
  passwordSalt String
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships OrganisationMembership[]
  sessions    AuthSession[]
  athletePortalAccesses AthletePortalAccess[]
  acceptedStaffInvitations StaffInvitation[] @relation("StaffInvitationAcceptedBy")
}

model Organisation {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganisationMembership[]
  sessions    AuthSession[]
  groups      TrainingGroup[]
  gymnasts    Gymnast[]
  coachingProgrammes CoachingProgramme[]
  rulesetAssignments OrganisationRulesetAssignment[]
  trainingSessions TrainingSession[]
  facilityLocations FacilityLocation[]
  testMetrics TestMetric[]
  testBatteries TestBattery[]
  testPointSystems TestPointSystem[]
  testingSessions TestingSession[]
  competitionEvents CompetitionEvent[]
  programmeLeadAssignments ProgrammeLeadAssignment[]
  methodologyRecords MethodologyRecord[]
  coachHandoffs CoachHandoff[]
  trustedContributors TrustedContributor[]
  athletePortalAccesses AthletePortalAccess[]
  calendarEvents CalendarEvent[]
  macrocycles Macrocycle[]
  trainingPlans TrainingPlan[]
  clubRotationPlans ClubRotationPlan[]
  extensionSkills ViaformSkill[]
  staffInvitations StaffInvitation[]
}

model OrganisationMembership {
  id                    String   @id @default(cuid())
  userId                String
  organisationId        String
  isAdministrator       Boolean  @default(false)
  coachingRoles         String   @default("[]")
  delegatedCapabilities String   @default("[]")
  apparatusSpecialties  String   @default("[]")
  pinHash                String?
  pinSalt                String?
  pinFailedAttempts      Int      @default(0)
  pinLockedUntil         DateTime?
  isActive              Boolean  @default(true)
  joinedAt              DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  groupAssignments TrainingGroupCoach[]
  createdTrainingSessions TrainingSession[]
  recordedTrainingEvidence TrainingEvidence[]
  recordedTrainingAttendance TrainingAttendance[]
  createdTestingSessions TestingSession[]
  recordedTestingResults TestingResult[]
  revisedTestingResults TestingResultRevision[]
  createdCompetitionEvents CompetitionEvent[]
  programmeLeaderships ProgrammeLeadAssignment[]
  createdMethodologyRecords MethodologyRecord[] @relation("MethodologyCreatedBy")
  approvedMethodologyRecords MethodologyRecord[] @relation("MethodologyApprovedBy")
  sentCoachHandoffs CoachHandoff[] @relation("HandoffFrom")
  receivedCoachHandoffs CoachHandoff[] @relation("HandoffTo")
  presentationPreference MembershipPresentationPreference?
  createdCalendarEvents CalendarEvent[]
  createdMacrocycles Macrocycle[]
  createdTrainingPlans TrainingPlan[]
  createdClubRotationPlans ClubRotationPlan[]
  coachedRotationSlots ClubRotationSlot[]

  @@unique([userId, organisationId])
  @@index([organisationId, isActive])
  @@index([userId, isActive])
}

model StaffInvitation {
  id                    String   @id @default(cuid())
  organisationId        String
  email                 String
  displayName           String?
  tokenHash             String   @unique
  isAdministrator       Boolean  @default(false)
  coachingRoles         String   @default("[]")
  delegatedCapabilities String   @default("[]")
  status                String   @default("PENDING")
  expiresAt             DateTime
  acceptedAt            DateTime?
  acceptedByUserId      String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  acceptedBy User? @relation("StaffInvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, email, status])
  @@index([organisationId, status, expiresAt])
  @@index([email, status, expiresAt])
}

model MembershipPresentationPreference {
  membershipId     String   @id
  homeWidgetOrder  String   @default("[]")
  homeWidgetHidden String   @default("[]")
  homeWidgetWide   String   @default("[]")
  theme            String   @default("preparation")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  membership OrganisationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
}

model AuthSession {
  id             String   @id @default(cuid())
  userId         String
  organisationId String?
  activeMembershipId String?
  activeMembershipSelectedAt DateTime?
  tokenHash      String   @unique
  expiresAt      DateTime
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([organisationId, expiresAt])
}

model TrainingGroup {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  status         String   @default("ACTIVE")
  archivedAt     DateTime?

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberships  GymnastTrainingGroup[]
  coachAssignments TrainingGroupCoach[]
  programmeAssignments TrainingGroupProgrammeAssignment[]
  scheduleSlots TrainingGroupSchedule[]
  trainingSessions TrainingSession[]
  facilityPreference TrainingGroupFacility?
  testingSessions TestingSession[]
  coachHandoffs CoachHandoff[]
  macrocycles MacrocycleGroup[]
  trainingPlans TrainingPlan[]
  clubRotationSlots ClubRotationSlot[]

  @@unique([organisationId, name])
  @@index([organisationId, name])
  @@index([organisationId, status, name])
}

model TrainingGroupSchedule {
  id              String @id @default(cuid())
  trainingGroupId String
  dayOfWeek       String
  startTime       String
  endTime         String
  notes           String?
  orderIndex      Int @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trainingGroup TrainingGroup @relation(fields: [trainingGroupId], references: [id], onDelete: Cascade)
  trainingSessions TrainingSession[]

  @@unique([trainingGroupId, dayOfWeek, startTime, endTime])
  @@index([trainingGroupId, orderIndex])
}

model Gymnast {
  id             String    @id @default(cuid())
  organisationId String
  name           String
  profileImageUrl String?
  dateOfBirth    DateTime?
  status         String    @default("ACTIVE")
  archivedAt     DateTime?
  transferredAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  groups       GymnastTrainingGroup[]
  programmeAssignments GymnastProgrammeAssignment[]
  rulesetAssignments GymnastRulesetAssignment[]
  trainingSessions TrainingSessionGymnast[]
  rotationAssignments SessionRotationGymnast[]
  trainingEvidence TrainingEvidence[]
  trainingAttendance TrainingAttendance[]
  testingSessions TestingSessionGymnast[]
  testingResults TestingResult[]
  routines GymnastRoutine[]
  competitionEntries CompetitionEntry[]
  handoffEntries CoachHandoffGymnast[]
  portalAccesses AthletePortalAccess[]
  macrocycles MacrocycleGymnast[]
  trainingPlans TrainingPlan[]
  trainingPlanItems TrainingPlanItem[]
  trainingPlanSkillTargets TrainingPlanSkillTarget[]
  trainingCheckIns TrainingCheckIn[]
  sessionBlockWorkItems SessionBlockWorkItem[]
  targetedSessionBlocks SessionBlock[]

  @@index([organisationId, status, name])
  @@index([organisationId, name])
}

model AthletePortalAccess {
  id             String   @id @default(cuid())
  userId         String
  organisationId String
  gymnastId      String
  relationship   String
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  gymnast      Gymnast      @relation(fields: [gymnastId], references: [id], onDelete: Cascade)

  @@unique([userId, gymnastId, relationship])
  @@index([organisationId, relationship, status])
  @@index([gymnastId, relationship, status])
  @@index([userId, status])
}

model GymnastTrainingGroup {
  gymnastId      String
  trainingGroupId String
  isPrimary      Boolean  @default(false)
  joinedAt       DateTime @default(now())

  gymnast      Gymnast       @relation(fields: [gymnastId], references: [id], onDelete: Cascade)
  trainingGroup TrainingGroup @relation(fields: [trainingGroupId], references: [id], onDelete: Cascade)

  @@id([gymnastId, trainingGroupId])
  @@index([trainingGroupId])
}


model TrainingGroupCoach {
  trainingGroupId String
  membershipId    String
  assignmentRole  String   @default("COACH")
  assignedAt      DateTime @default(now())

  trainingGroup TrainingGroup          @relation(fields: [trainingGroupId], references: [id], onDelete: Cascade)
  membership    OrganisationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([trainingGroupId, membershipId])
  @@index([membershipId])
}

model CoachingProgramme {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  programmeType  String
  discipline     String   @default("GENERAL")
  description    String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  stages ProgrammeStage[]
  groupAssignments TrainingGroupProgrammeAssignment[]
  gymnastAssignments GymnastProgrammeAssignment[]
  trainingSessions TrainingSession[]
  leads ProgrammeLeadAssignment[]
  methodologyRecords MethodologyRecord[]

  @@unique([organisationId, name])
  @@index([organisationId, programmeType, status])
}

model ProgrammeStage {
  id          String   @id @default(cuid())
  programmeId String
  name        String
  orderIndex  Int      @default(0)
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  programme CoachingProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  groupAssignments TrainingGroupProgrammeAssignment[]
  gymnastAssignments GymnastProgrammeAssignment[]
  trainingSessions TrainingSession[]
  skillRequirements ProgrammeStageSkill[]

  @@unique([programmeId, name])
  @@index([programmeId, orderIndex, status])
}

model TrainingGroupProgrammeAssignment {
  trainingGroupId String @id
  programmeId String
  stageId String?
  assignedAt DateTime @default(now())
  trainingGroup TrainingGroup @relation(fields: [trainingGroupId], references: [id], onDelete: Cascade)
  programme CoachingProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  stage ProgrammeStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  @@index([programmeId, stageId])
}

model GymnastProgrammeAssignment {
  gymnastId String @id
  programmeId String
  stageId String?
  assignedAt DateTime @default(now())
  gymnast Gymnast @relation(fields: [gymnastId], references: [id], onDelete: Cascade)
  programme CoachingProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  stage ProgrammeStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  @@index([programmeId, stageId])
}



model GymnastTrainingPriority {
  id                     String   @id @default(cuid())
  organisationId         String
  gymnastId              String
  priority               String
  focus                  String?
  rationale              String?
  setByMembershipId      String
  startedAt              DateTime @default(now())
  endedAt                DateTime?
  endedByMembershipId    String?
  endReason              String?
  createdAt              DateTime @default(now())

  @@index([organisationId, gymnastId, startedAt])
  @@index([gymnastId, endedAt])
}

model GymnastProgrammeAssignmentHistory {
  id             String   @id @default(cuid())
  organisationId String
  gymnastId      String
  programmeId    String?
  stageId        String?
  programmeName  String
  stageName      String?
  startedAt      DateTime
  endedAt        DateTime?
  changeReason   String?
  createdAt      DateTime @default(now())

  @@index([organisationId, gymnastId, startedAt])
  @@index([gymnastId, endedAt])
}

model TrainingGroupProgrammeAssignmentHistory {
  id              String   @id @default(cuid())
  organisationId  String
  trainingGroupId String
  programmeId     String?
  stageId         String?
  programmeName   String
  stageName       String?
  startedAt       DateTime
  endedAt         DateTime?
  changeReason    String?
  createdAt       DateTime @default(now())

  @@index([organisationId, trainingGroupId, startedAt])
  @@index([trainingGroupId, endedAt])
}

model ProgrammeLeadAssignment {
  id           String   @id @default(cuid())
  organisationId String
  programmeId  String
  membershipId String
  assignedAt   DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  programme CoachingProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  membership OrganisationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([programmeId, membershipId])
  @@index([organisationId, membershipId])
}

model MethodologyRecord {
  id                    String   @id @default(cuid())
  organisationId        String
  programmeId           String?
  createdByMembershipId String
  approvedByMembershipId String?
  scopeType             String   @default("GLOBAL")
  scopeRef              String?
  apparatus             String?
  title                 String
  provenance            String   @default("COACH_METHODOLOGY")
  contributorName       String?
  technicalObjective    String?
  technicalBoundaries   String?
  defaultApproach       String?
  alternativeApproaches String?
  uncertainty           String?
  sourceNote            String?
  sourceUrl             String?
  trustedContributorId  String?
  status                String   @default("DRAFT")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  approvedAt            DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  programme CoachingProgramme? @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  createdBy OrganisationMembership @relation("MethodologyCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  approvedBy OrganisationMembership? @relation("MethodologyApprovedBy", fields: [approvedByMembershipId], references: [id], onDelete: SetNull)
  trustedContributor TrustedContributor? @relation(fields: [trustedContributorId], references: [id], onDelete: SetNull)

  @@index([organisationId, status, scopeType])
  @@index([organisationId, apparatus, status])
  @@index([programmeId, status])
  @@index([trustedContributorId, status])
}

model TrustedContributor {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  roleLabel      String?
  organisationName String?
  scopeNote      String?
  sourceNote     String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  methodologyRecords MethodologyRecord[]

  @@unique([organisationId, name])
  @@index([organisationId, status, name])
}

model GymnastRoutine {
  id                   String   @id @default(cuid())
  gymnastId            String
  apparatus            String
  name                 String
  purpose              String   @default("CURRENT")
  status               String   @default("ACTIVE")
  rulesetProgramCode   String?
  rulesetProgramName   String?
  rulesetLevelCode     String?
  rulesetLevelName     String?
  rulesetPackageCode   String?
  rulesetVersionLabel  String?
  strategyNote         String?
  pathwayNote          String?
  vaultMode            String   @default("ONE_VAULT")
  routineDurationSeconds Int?
  musicFileName        String?
  musicMimeType        String?
  musicStorageRef      String?
  musicDurationSeconds Float?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  gymnast Gymnast @relation(fields: [gymnastId], references: [id], onDelete: Cascade)
  elements GymnastRoutineElement[]
  vaults GymnastRoutineVault[]
  customItems GymnastRoutineCustomItem[]
  sections RoutineSection[]
  competitionPlans CompetitionApparatusPlan[]

  @@unique([gymnastId, apparatus, name])
  @@index([gymnastId, apparatus, status])
  @@index([gymnastId, purpose, status])
}

model GymnastRoutineElement {
  id                  String   @id @default(cuid())
  routineId           String
  elementDefinitionId String
  orderIndex          Int
  recognition         String   @default("UNKNOWN")
  isDismount          Boolean  @default(false)
  coachNote           String?
  sectionId           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  routine GymnastRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  elementDefinition FigElementDefinition @relation(fields: [elementDefinitionId], references: [id], onDelete: Restrict)
  section RoutineSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  trainingEvidence TrainingEvidence[]

  @@unique([routineId, orderIndex])
  @@index([routineId, elementDefinitionId])
  @@index([sectionId])
}

model GymnastRoutineVault {
  id                String   @id @default(cuid())
  routineId         String
  vaultDefinitionId String
  orderIndex        Int
  role              String   @default("PRIMARY")
  coachNote         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  routine GymnastRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  vaultDefinition FigVaultDefinition @relation(fields: [vaultDefinitionId], references: [id], onDelete: Restrict)
  trainingEvidence TrainingEvidence[]

  @@unique([routineId, orderIndex])
  @@index([routineId, vaultDefinitionId])
}

model GymnastRoutineCustomItem {
  id           String   @id @default(cuid())
  routineId    String
  label        String
  orderIndex   Int
  role         String?
  coachNote    String?
  sectionId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  routine GymnastRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  section RoutineSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  trainingEvidence TrainingEvidence[]

  @@unique([routineId, orderIndex])
  @@index([routineId])
  @@index([sectionId])
}

model RoutineSection {
  id              String   @id @default(cuid())
  routineId       String
  sectionType     String
  title           String
  orderIndex      Int      @default(0)
  startTimeSec    Float?
  endTimeSec      Float?
  startX          Float?
  startY          Float?
  endX            Float?
  endY            Float?
  pathJson        String   @default("[]")
  startRail       String?
  endRail         String?
  startPosition   String?
  endPosition     String?
  facing          String?
  direction       String?
  rhythm          String?
  musicCue        String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  routine GymnastRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  elements GymnastRoutineElement[]
  customItems GymnastRoutineCustomItem[]

  @@index([routineId, orderIndex])
  @@index([routineId, sectionType])
}

model TrainingSession {
  id                    String   @id @default(cuid())
  organisationId        String
  trainingGroupId       String
  scheduleSlotId        String?
  trainingPlanId        String?
  clubRotationPlanId    String?
  clubRotationVariant   Int?
  createdByMembershipId String
  sessionDate           DateTime
  startTime             String
  endTime               String
  title                 String
  sessionIntent         String?
  notes                 String?
  batteryNameSnapshot   String?
  batteryVersionSnapshot Int?
  batteryDefinitionSnapshot String?
  status                String   @default("PLANNED")
  programmeId           String?
  programmeStageId      String?
  programmeNameSnapshot String?
  stageNameSnapshot     String?
  startedAt             DateTime?
  endedAt               DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  trainingGroup TrainingGroup @relation(fields: [trainingGroupId], references: [id], onDelete: Cascade)
  scheduleSlot TrainingGroupSchedule? @relation(fields: [scheduleSlotId], references: [id], onDelete: SetNull)
  trainingPlan TrainingPlan? @relation(fields: [trainingPlanId], references: [id], onDelete: SetNull)
  clubRotationPlan ClubRotationPlan? @relation(fields: [clubRotationPlanId], references: [id], onDelete: SetNull)
  createdBy OrganisationMembership @relation(fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  programme CoachingProgramme? @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  programmeStage ProgrammeStage? @relation(fields: [programmeStageId], references: [id], onDelete: SetNull)
  blocks SessionBlock[]
  gymnasts TrainingSessionGymnast[]
  facilityAssignment TrainingSessionFacility?
  rotationGroups SessionRotationGroup[]
  rotationGymnasts SessionRotationGymnast[]
  rotationAssignments SessionRotationAssignment[]
  evidence TrainingEvidence[]
  attendance TrainingAttendance[]
  checkIns TrainingCheckIn[]

  @@index([organisationId, sessionDate])
  @@index([trainingGroupId, sessionDate])
  @@index([trainingPlanId, sessionDate])
  @@index([clubRotationPlanId, sessionDate])
  @@index([createdByMembershipId, sessionDate])
}

model TrainingSessionGymnast {
  sessionId  String
  gymnastId  String
  source     String   @default("GROUP")
  assignedAt DateTime @default(now())

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  gymnast Gymnast @relation(fields: [gymnastId], references: [id], onDelete: Cascade)

  @@id([sessionId, gymnastId])
  @@index([gymnastId, assignedAt])
}

model SessionBlock {
  id             String   @id @default(cuid())
  sessionId      String
  targetGymnastId String?
  targetCount    Int?
  title          String
  category       String
  behaviour      String   @default("EVIDENCE")
  apparatus      String?
  durationMin    Int?
  groupObjective String?
  notes          String?
  orderIndex     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  targetGymnast Gymnast? @relation(fields: [targetGymnastId], references: [id], onDelete: SetNull)
  spaceAssignment SessionBlockSpace?
  resourceAssignments SessionBlockResource[]
  rotationAssignments SessionRotationAssignment[]
  evidence TrainingEvidence[]
  checkIns TrainingCheckIn[]
  stations SessionStation[]
  workItems SessionBlockWorkItem[]

  @@index([sessionId, orderIndex])
  @@index([targetGymnastId])
}

model SessionBlockWorkItem {
  id                 String   @id @default(cuid())
  blockId            String
  trainingPlanItemId String?
  targetGymnastId    String?
  title              String
  targetCount        Int?
  skillId             String?
  elementDefinitionId String?
  vaultDefinitionId   String?
  trainingResourceId  String?
  landingResourceId   String?
  trainingSurface     String?
  landingSurface      String?
  takeoffEquipment    String?
  notes              String?
  orderIndex         Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  block SessionBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  trainingPlanItem TrainingPlanItem? @relation(fields: [trainingPlanItemId], references: [id], onDelete: SetNull)
  targetGymnast Gymnast? @relation(fields: [targetGymnastId], references: [id], onDelete: SetNull)
  skill ViaformSkill? @relation(fields: [skillId], references: [id], onDelete: SetNull)
  elementDefinition FigElementDefinition? @relation("WorkItemElementDefinition", fields: [elementDefinitionId], references: [id], onDelete: SetNull)
  vaultDefinition FigVaultDefinition? @relation("WorkItemVaultDefinition", fields: [vaultDefinitionId], references: [id], onDelete: SetNull)
  trainingResource FacilityResource? @relation("WorkItemTrainingResource", fields: [trainingResourceId], references: [id], onDelete: SetNull)
  landingResource FacilityResource? @relation("WorkItemLandingResource", fields: [landingResourceId], references: [id], onDelete: SetNull)
  stations SessionStation[]
  evidence TrainingEvidence[]

  @@index([blockId, orderIndex])
  @@index([skillId])
  @@index([elementDefinitionId])
  @@index([vaultDefinitionId])
  @@index([trainingPlanItemId])
  @@index([targetGymnastId])
}

model FacilityLocation {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  notes          String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  spaces TrainingSpace[]
  clubRotationPlans ClubRotationPlan[]
  groupPreferences TrainingGroupFacility[]
  sessionAssignments TrainingSessionFacility[]

  @@unique([organisationId, name])
  @@index([organisationId, status])
}

model TrainingSpace {
  id         String   @id @default(cuid())
  locationId String
  name       String
  apparatus  String?
  capacity   Int?
  shareable  Boolean  @default(true)
  notes      String?
  status     String   @default("ACTIVE")
  orderIndex Int      @default(0)
