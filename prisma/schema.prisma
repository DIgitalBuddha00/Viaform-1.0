generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Viaform 1.0 canonical identity and organisation boundary.
// A fresh database contains no organisations, users, memberships, sessions,
// coaching profiles, QA records, demo records, or seeded product data.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String
  passwordHash String
  passwordSalt String
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships OrganisationMembership[]
  sessions    AuthSession[]
}

model Organisation {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganisationMembership[]
  sessions    AuthSession[]
  groups      TrainingGroup[]
  gymnasts    Gymnast[]
  coachingProgrammes CoachingProgramme[]
  rulesetAssignments OrganisationRulesetAssignment[]
  trainingSessions TrainingSession[]
  facilityLocations FacilityLocation[]
  testMetrics TestMetric[]
  testingSessions TestingSession[]
}

model OrganisationMembership {
  id                    String   @id @default(cuid())
  userId                String
  organisationId        String
  isAdministrator       Boolean  @default(false)
  coachingRoles         String   @default("[]")
  delegatedCapabilities String   @default("[]")
  apparatusSpecialties  String   @default("[]")
  isActive              Boolean  @default(true)
  joinedAt              DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  groupAssignments TrainingGroupCoach[]
  createdTrainingSessions TrainingSession[]
  recordedTrainingEvidence TrainingEvidence[]
  recordedTrainingAttendance TrainingAttendance[]
  createdTestingSessions TestingSession[]
  recordedTestingResults TestingResult[]

  @@unique([userId, organisationId])
  @@index([organisationId, isActive])
  @@index([userId, isActive])
}

model AuthSession {
  id             String   @id @default(cuid())
  userId         String
  organisationId String?
  tokenHash      String   @unique
  expiresAt      DateTime
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([organisationId, expiresAt])
}

model TrainingGroup {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberships  GymnastTrainingGroup[]
  coachAssignments TrainingGroupCoach[]
  programmeAssignments TrainingGroupProgrammeAssignment[]
  scheduleSlots TrainingGroupSchedule[]
  trainingSessions TrainingSession[]
  facilityPreference TrainingGroupFacility?
  testingSessions TestingSession[]

  @@unique([organisationId, name])
  @@index([organisationId, name])
}

model TrainingGroupSchedule {
  id              String @id @default(cuid())
  trainingGroupId String
  dayOfWeek       String
  startTime       String
  endTime         String
  notes           String?
  orderIndex      Int @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trainingGroup TrainingGroup @relation(fields: [trainingGroupId], references: [id], onDelete: Cascade)
  trainingSessions TrainingSession[]

  @@unique([trainingGroupId, dayOfWeek, startTime, endTime])
  @@index([trainingGroupId, orderIndex])
}

model Gymnast {
  id             String    @id @default(cuid())
  organisationId String
  name           String
  dateOfBirth    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  groups       GymnastTrainingGroup[]
  programmeAssignments GymnastProgrammeAssignment[]
  rulesetAssignments GymnastRulesetAssignment[]
  trainingSessions TrainingSessionGymnast[]
  rotationAssignments SessionRotationGymnast[]
  trainingEvidence TrainingEvidence[]
  trainingAttendance TrainingAttendance[]
  testingSessions TestingSessionGymnast[]
  testingResults TestingResult[]
  routines GymnastRoutine[]

  @@index([organisationId, name])
}

model GymnastTrainingGroup {
  gymnastId      String
  trainingGroupId String
  isPrimary      Boolean  @default(false)
  joinedAt       DateTime @default(now())

  gymnast      Gymnast       @relation(fields: [gymnastId], references: [id], onDelete: Cascade)
  trainingGroup TrainingGroup @relation(fields: [trainingGroupId], references: [id], onDelete: Cascade)

  @@id([gymnastId, trainingGroupId])
  @@index([trainingGroupId])
}


model TrainingGroupCoach {
  trainingGroupId String
  membershipId    String
  assignmentRole  String   @default("COACH")
  assignedAt      DateTime @default(now())

  trainingGroup TrainingGroup          @relation(fields: [trainingGroupId], references: [id], onDelete: Cascade)
  membership    OrganisationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([trainingGroupId, membershipId])
  @@index([membershipId])
}

model CoachingProgramme {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  programmeType  String
  discipline     String   @default("GENERAL")
  description    String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  stages ProgrammeStage[]
  groupAssignments TrainingGroupProgrammeAssignment[]
  gymnastAssignments GymnastProgrammeAssignment[]
  trainingSessions TrainingSession[]

  @@unique([organisationId, name])
  @@index([organisationId, programmeType, status])
}

model ProgrammeStage {
  id          String   @id @default(cuid())
  programmeId String
  name        String
  orderIndex  Int      @default(0)
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  programme CoachingProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  groupAssignments TrainingGroupProgrammeAssignment[]
  gymnastAssignments GymnastProgrammeAssignment[]
  trainingSessions TrainingSession[]

  @@unique([programmeId, name])
  @@index([programmeId, orderIndex, status])
}

model TrainingGroupProgrammeAssignment {
  trainingGroupId String @id
  programmeId String
  stageId String?
  assignedAt DateTime @default(now())
  trainingGroup TrainingGroup @relation(fields: [trainingGroupId], references: [id], onDelete: Cascade)
  programme CoachingProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  stage ProgrammeStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  @@index([programmeId, stageId])
}

model GymnastProgrammeAssignment {
  gymnastId String @id
  programmeId String
  stageId String?
  assignedAt DateTime @default(now())
  gymnast Gymnast @relation(fields: [gymnastId], references: [id], onDelete: Cascade)
  programme CoachingProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  stage ProgrammeStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  @@index([programmeId, stageId])
}

model GymnastRoutine {
  id                   String   @id @default(cuid())
  gymnastId            String
  apparatus            String
  name                 String
  purpose              String   @default("CURRENT")
  status               String   @default("ACTIVE")
  rulesetProgramCode   String?
  rulesetProgramName   String?
  rulesetLevelCode     String?
  rulesetLevelName     String?
  rulesetPackageCode   String?
  rulesetVersionLabel  String?
  strategyNote         String?
  pathwayNote          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  gymnast Gymnast @relation(fields: [gymnastId], references: [id], onDelete: Cascade)
  elements GymnastRoutineElement[]
  vaults GymnastRoutineVault[]

  @@unique([gymnastId, apparatus, name])
  @@index([gymnastId, apparatus, status])
  @@index([gymnastId, purpose, status])
}

model GymnastRoutineElement {
  id                  String   @id @default(cuid())
  routineId           String
  elementDefinitionId String
  orderIndex          Int
  recognition         String   @default("UNKNOWN")
  isDismount          Boolean  @default(false)
  coachNote           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  routine GymnastRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  elementDefinition FigElementDefinition @relation(fields: [elementDefinitionId], references: [id], onDelete: Restrict)
  trainingEvidence TrainingEvidence[]

  @@unique([routineId, orderIndex])
  @@index([routineId, elementDefinitionId])
}

model GymnastRoutineVault {
  id                String   @id @default(cuid())
  routineId         String
  vaultDefinitionId String
  orderIndex        Int
  role              String   @default("PRIMARY")
  coachNote         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  routine GymnastRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  vaultDefinition FigVaultDefinition @relation(fields: [vaultDefinitionId], references: [id], onDelete: Restrict)
  trainingEvidence TrainingEvidence[]

  @@unique([routineId, orderIndex])
  @@index([routineId, vaultDefinitionId])
}

model TrainingSession {
  id                    String   @id @default(cuid())
  organisationId        String
  trainingGroupId       String
  scheduleSlotId        String?
  createdByMembershipId String
  sessionDate           DateTime
  startTime             String
  endTime               String
  title                 String
  sessionIntent         String?
  notes                 String?
  status                String   @default("PLANNED")
  programmeId           String?
  programmeStageId      String?
  programmeNameSnapshot String?
  stageNameSnapshot     String?
  startedAt             DateTime?
  endedAt               DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  trainingGroup TrainingGroup @relation(fields: [trainingGroupId], references: [id], onDelete: Cascade)
  scheduleSlot TrainingGroupSchedule? @relation(fields: [scheduleSlotId], references: [id], onDelete: SetNull)
  createdBy OrganisationMembership @relation(fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  programme CoachingProgramme? @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  programmeStage ProgrammeStage? @relation(fields: [programmeStageId], references: [id], onDelete: SetNull)
  blocks SessionBlock[]
  gymnasts TrainingSessionGymnast[]
  facilityAssignment TrainingSessionFacility?
  rotationGroups SessionRotationGroup[]
  rotationGymnasts SessionRotationGymnast[]
  rotationAssignments SessionRotationAssignment[]
  evidence TrainingEvidence[]
  attendance TrainingAttendance[]

  @@index([organisationId, sessionDate])
  @@index([trainingGroupId, sessionDate])
  @@index([createdByMembershipId, sessionDate])
}

model TrainingSessionGymnast {
  sessionId  String
  gymnastId  String
  source     String   @default("GROUP")
  assignedAt DateTime @default(now())

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  gymnast Gymnast @relation(fields: [gymnastId], references: [id], onDelete: Cascade)

  @@id([sessionId, gymnastId])
  @@index([gymnastId, assignedAt])
}

model SessionBlock {
  id             String   @id @default(cuid())
  sessionId      String
  title          String
  category       String
  apparatus      String?
  durationMin    Int?
  groupObjective String?
  notes          String?
  orderIndex     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  spaceAssignment SessionBlockSpace?
  resourceAssignments SessionBlockResource[]
  rotationAssignments SessionRotationAssignment[]
  evidence TrainingEvidence[]
  stations SessionStation[]

  @@index([sessionId, orderIndex])
}

model FacilityLocation {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  notes          String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  spaces TrainingSpace[]
  groupPreferences TrainingGroupFacility[]
  sessionAssignments TrainingSessionFacility[]

  @@unique([organisationId, name])
  @@index([organisationId, status])
}

model TrainingSpace {
  id         String   @id @default(cuid())
  locationId String
  name       String
  capacity   Int?
  shareable  Boolean  @default(true)
  notes      String?
  status     String   @default("ACTIVE")
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  location FacilityLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  resources FacilityResource[]
  blockAssignments SessionBlockSpace[]
  rotationAssignments SessionRotationAssignment[]

  @@unique([locationId, name])
  @@index([locationId, orderIndex, status])
}

model FacilityResource {
  id              String   @id @default(cuid())
  trainingSpaceId String
  name            String
  category        String
  quantity        Int      @default(1)
  capacity        Int      @default(1)
  availability    String   @default("AVAILABLE")
  setupNotes      String?
  status          String   @default("ACTIVE")
  orderIndex      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trainingSpace TrainingSpace @relation(fields: [trainingSpaceId], references: [id], onDelete: Cascade)
  blockAssignments SessionBlockResource[]

  @@unique([trainingSpaceId, name])
  @@index([trainingSpaceId, category, status])
}

model TrainingGroupFacility {
  trainingGroupId String @id
  locationId      String
  assignedAt      DateTime @default(now())

  trainingGroup TrainingGroup @relation(fields: [trainingGroupId], references: [id], onDelete: Cascade)
  location FacilityLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
}

model TrainingSessionFacility {
  sessionId  String @id
  locationId String
  assignedAt DateTime @default(now())

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  location FacilityLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
}

model SessionBlockSpace {
  blockId         String @id
  trainingSpaceId String
  assignedAt      DateTime @default(now())

  block SessionBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  trainingSpace TrainingSpace @relation(fields: [trainingSpaceId], references: [id], onDelete: Cascade)

  @@index([trainingSpaceId])
}

model SessionBlockResource {
  blockId    String
  resourceId String
  quantity   Int @default(1)
  assignedAt DateTime @default(now())

  block SessionBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  resource FacilityResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([blockId, resourceId])
  @@index([resourceId])
}

model SessionRotationGroup {
  id         String   @id @default(cuid())
  sessionId  String
  name       String
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  gymnasts SessionRotationGymnast[]
  assignments SessionRotationAssignment[]

  @@unique([sessionId, name])
  @@index([sessionId, orderIndex])
}

model SessionRotationGymnast {
  sessionId       String
  gymnastId       String
  rotationGroupId String
  assignedAt      DateTime @default(now())

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  gymnast Gymnast @relation(fields: [gymnastId], references: [id], onDelete: Cascade)
  rotationGroup SessionRotationGroup @relation(fields: [rotationGroupId], references: [id], onDelete: Cascade)

  @@id([sessionId, gymnastId])
  @@index([rotationGroupId, assignedAt])
}

model SessionRotationAssignment {
  id              String   @id @default(cuid())
  sessionId       String
  rotationGroupId String
  blockId         String?
  trainingSpaceId String?
  startTime       String
  endTime         String
  notes           String?
  orderIndex      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rotationGroup SessionRotationGroup @relation(fields: [rotationGroupId], references: [id], onDelete: Cascade)
  block SessionBlock? @relation(fields: [blockId], references: [id], onDelete: SetNull)
  trainingSpace TrainingSpace? @relation(fields: [trainingSpaceId], references: [id], onDelete: SetNull)

  @@index([sessionId, startTime, endTime])
  @@index([rotationGroupId, orderIndex])
  @@index([trainingSpaceId, startTime, endTime])
}

model TrainingAttendance {
  sessionId              String
  gymnastId              String
  status                 String   @default("NOT_RECORDED")
  recordedByMembershipId String
  recordedAt             DateTime @default(now())
  updatedAt              DateTime @updatedAt

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  gymnast Gymnast @relation(fields: [gymnastId], references: [id], onDelete: Cascade)
  recordedBy OrganisationMembership @relation(fields: [recordedByMembershipId], references: [id], onDelete: Restrict)

  @@id([sessionId, gymnastId])
  @@index([gymnastId, recordedAt])
  @@index([recordedByMembershipId, recordedAt])
}

model TestMetric {
  id              String   @id @default(cuid())
  organisationId  String
  name            String
  category        String   @default("CUSTOM")
  apparatus       String?
  description     String?
  protocol        String?
  captureMode     String   @default("MEASUREMENT")
  unit            String?
  durationSeconds Int?
  direction       String   @default("COACH_INTERPRETATION")
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  results TestingResult[]

  @@unique([organisationId, name])
  @@index([organisationId, category, status])
}

model TestingSession {
  id                    String   @id @default(cuid())
  organisationId        String
  trainingGroupId       String
  createdByMembershipId String
  name                  String
  testedAt              DateTime
  purpose               String?
  conditions            String?
  notes                 String?
  status                String   @default("IN_PROGRESS")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  trainingGroup TrainingGroup @relation(fields: [trainingGroupId], references: [id], onDelete: Cascade)
  createdBy OrganisationMembership @relation(fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  gymnasts TestingSessionGymnast[]
  results TestingResult[]

  @@index([organisationId, testedAt])
  @@index([trainingGroupId, testedAt])
}

model TestingSessionGymnast {
  sessionId  String
  gymnastId  String
  assignedAt DateTime @default(now())

  session TestingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  gymnast Gymnast @relation(fields: [gymnastId], references: [id], onDelete: Cascade)

  @@id([sessionId, gymnastId])
  @@index([gymnastId, assignedAt])
}

model TestingResult {
  id                     String   @id @default(cuid())
  sessionId              String
  gymnastId              String
  metricId               String
  recordedByMembershipId String
  numberValue            Float
  note                   String?
  recordedAt             DateTime @default(now())
  updatedAt              DateTime @updatedAt

  session TestingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  gymnast Gymnast @relation(fields: [gymnastId], references: [id], onDelete: Cascade)
  metric TestMetric @relation(fields: [metricId], references: [id], onDelete: Restrict)
  recordedBy OrganisationMembership @relation(fields: [recordedByMembershipId], references: [id], onDelete: Restrict)

  @@unique([sessionId, gymnastId, metricId])
  @@index([gymnastId, metricId, recordedAt])
  @@index([metricId, recordedAt])
  @@index([recordedByMembershipId, recordedAt])
}

model SessionStation {
  id           String   @id @default(cuid())
  blockId      String
  name         String
  objective    String?
  drills       String?
  equipment    String?
  setup        String?
  cues         String?
  easierOption String?
  harderOption String?
  orderIndex   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  block SessionBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  evidence TrainingEvidence[]

  @@unique([blockId, name])
  @@index([blockId, orderIndex])
}

model TrainingEvidence {
  id                     String   @id @default(cuid())
  sessionId              String
  blockId                String
  stationId              String?
  gymnastId              String
  routineElementId       String?
  routineVaultId         String?
  recordedByMembershipId String
  outcome                String
  note                   String?
  recordedAt             DateTime @default(now())

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  block SessionBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  station SessionStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  gymnast Gymnast @relation(fields: [gymnastId], references: [id], onDelete: Cascade)
  routineElement GymnastRoutineElement? @relation(fields: [routineElementId], references: [id], onDelete: SetNull)
  routineVault GymnastRoutineVault? @relation(fields: [routineVaultId], references: [id], onDelete: SetNull)
  recordedBy OrganisationMembership @relation(fields: [recordedByMembershipId], references: [id], onDelete: Restrict)

  @@index([sessionId, blockId, recordedAt])
  @@index([routineElementId, recordedAt])
  @@index([routineVaultId, recordedAt])
  @@index([stationId, recordedAt])
  @@index([gymnastId, recordedAt])
  @@index([recordedByMembershipId, recordedAt])
}

model RulesetProgram {
 id String @id @default(cuid())
 code String @unique
 name String
 governingBody String
 discipline String @default("WAG")
 status String @default("ACTIVE")
 sourceUrl String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 levels RulesetLevel[]
 organisationAssignments OrganisationRulesetAssignment[]
 gymnastAssignments GymnastRulesetAssignment[]
 packages RulesetPackage[]
 @@index([governingBody, discipline, status])
}
model RulesetLevel {
 id String @id @default(cuid())
 programId String
 code String
 name String
 orderIndex Int @default(0)
 status String @default("ACTIVE")
 notes String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 program RulesetProgram @relation(fields:[programId],references:[id],onDelete:Cascade)
 gymnastAssignments GymnastRulesetAssignment[]
 @@unique([programId,code])
 @@index([programId,orderIndex,status])
}
model OrganisationRulesetAssignment {
 organisationId String
 programId String
 enabledAt DateTime @default(now())
 organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade)
 program RulesetProgram @relation(fields:[programId],references:[id],onDelete:Cascade)
 @@id([organisationId,programId])
 @@index([programId])
}
model GymnastRulesetAssignment {
 gymnastId String @id
 programId String
 levelId String?
 assignedAt DateTime @default(now())
 gymnast Gymnast @relation(fields:[gymnastId],references:[id],onDelete:Cascade)
 program RulesetProgram @relation(fields:[programId],references:[id],onDelete:Cascade)
 level RulesetLevel? @relation(fields:[levelId],references:[id],onDelete:SetNull)
 @@index([programId,levelId])
}

model RulesetPackage {
 id String @id @default(cuid())
 programId String
 code String @unique
 name String
 cycleLabel String
 versionLabel String
 effectiveDate DateTime
 sourceDocument String
 sourceUrl String?
 sourcePublishedAt DateTime?
 status String @default("ACTIVE")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 program RulesetProgram @relation(fields:[programId],references:[id],onDelete:Cascade)
 vaults FigVaultDefinition[]
 elements FigElementDefinition[]
 apparatusRules RulesetApparatusRule[]
 @@index([programId,effectiveDate,status])
}
model FigVaultDefinition {
 id String @id @default(cuid())
 packageId String
 officialNumber String
 variantKey String @default("a")
 groupNumber Int
 name String
 aliases String @default("[]")
 dValue Float
 secondFlightDirection String @default("NON_SALTO")
 doubleSalto Boolean @default(false)
 status String @default("ACTIVE")
 package RulesetPackage @relation(fields:[packageId],references:[id],onDelete:Cascade)
 routineSelections GymnastRoutineVault[]
 @@unique([packageId,officialNumber,variantKey])
 @@index([packageId,groupNumber,status])
}

model FigElementDefinition {
 id String @id @default(cuid())
 packageId String
 apparatus String
 officialNumber String
 variantKey String @default("a")
 name String
 aliases String @default("[]")
 difficulty String?
 groupCode String
 groupName String
 sourcePage Int?
 metadata String @default("{}")
 verificationStatus String @default("NEEDS_REVIEW")
 status String @default("ACTIVE")
 package RulesetPackage @relation(fields:[packageId],references:[id],onDelete:Cascade)
 routineSelections GymnastRoutineElement[]
 @@unique([packageId,apparatus,officialNumber,variantKey])
 @@index([packageId,apparatus,groupCode,status])
}
model RulesetApparatusRule {
 id String @id @default(cuid())
 packageId String
 apparatus String
 levelCode String @default("ALL")
