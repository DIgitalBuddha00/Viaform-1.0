generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Viaform 1.0 canonical identity and organisation boundary.
// A fresh database contains no organisations, users, memberships, sessions,
// coaching profiles, QA records, demo records, or seeded product data.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String
  passwordHash String
  passwordSalt String
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships OrganisationMembership[]
  sessions    AuthSession[]
}

model Organisation {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganisationMembership[]
  sessions    AuthSession[]
  groups      TrainingGroup[]
  gymnasts    Gymnast[]
  coachingProgrammes CoachingProgramme[]
  rulesetAssignments OrganisationRulesetAssignment[]
  trainingSessions TrainingSession[]
  facilityLocations FacilityLocation[]
}

model OrganisationMembership {
  id                    String   @id @default(cuid())
  userId                String
  organisationId        String
  isAdministrator       Boolean  @default(false)
  coachingRoles         String   @default("[]")
  delegatedCapabilities String   @default("[]")
  apparatusSpecialties  String   @default("[]")
  isActive              Boolean  @default(true)
  joinedAt              DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  groupAssignments TrainingGroupCoach[]
  createdTrainingSessions TrainingSession[]

  @@unique([userId, organisationId])
  @@index([organisationId, isActive])
  @@index([userId, isActive])
}

model AuthSession {
  id             String   @id @default(cuid())
  userId         String
  organisationId String?
  tokenHash      String   @unique
  expiresAt      DateTime
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  @@index([userId, expiresAt])
  @@index([organisationId, expiresAt])
}

model TrainingGroup {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberships  GymnastTrainingGroup[]
  coachAssignments TrainingGroupCoach[]
  programmeAssignments TrainingGroupProgrammeAssignment[]
  scheduleSlots TrainingGroupSchedule[]
  trainingSessions TrainingSession[]
  facilityPreference TrainingGroupFacility?

  @@unique([organisationId, name])
  @@index([organisationId, name])
}

model TrainingGroupSchedule {
  id              String @id @default(cuid())
  trainingGroupId String
  dayOfWeek       String
  startTime       String
  endTime         String
  notes           String?
  orderIndex      Int @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trainingGroup TrainingGroup @relation(fields: [trainingGroupId], references: [id], onDelete: Cascade)
  trainingSessions TrainingSession[]

  @@unique([trainingGroupId, dayOfWeek, startTime, endTime])
  @@index([trainingGroupId, orderIndex])
}

model Gymnast {
  id             String    @id @default(cuid())
  organisationId String
  name           String
  dateOfBirth    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  groups       GymnastTrainingGroup[]
  programmeAssignments GymnastProgrammeAssignment[]
  rulesetAssignments GymnastRulesetAssignment[]
  trainingSessions TrainingSessionGymnast[]

  @@index([organisationId, name])
}

model GymnastTrainingGroup {
  gymnastId      String
  trainingGroupId String
  isPrimary      Boolean  @default(false)
  joinedAt       DateTime @default(now())

  gymnast      Gymnast       @relation(fields: [gymnastId], references: [id], onDelete: Cascade)
  trainingGroup TrainingGroup @relation(fields: [trainingGroupId], references: [id], onDelete: Cascade)

  @@id([gymnastId, trainingGroupId])
  @@index([trainingGroupId])
}


model TrainingGroupCoach {
  trainingGroupId String
  membershipId    String
  assignmentRole  String   @default("COACH")
  assignedAt      DateTime @default(now())

  trainingGroup TrainingGroup          @relation(fields: [trainingGroupId], references: [id], onDelete: Cascade)
  membership    OrganisationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([trainingGroupId, membershipId])
  @@index([membershipId])
}

model CoachingProgramme {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  programmeType  String
  discipline     String   @default("GENERAL")
  description    String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  stages ProgrammeStage[]
  groupAssignments TrainingGroupProgrammeAssignment[]
  gymnastAssignments GymnastProgrammeAssignment[]
  trainingSessions TrainingSession[]

  @@unique([organisationId, name])
  @@index([organisationId, programmeType, status])
}

model ProgrammeStage {
  id          String   @id @default(cuid())
  programmeId String
  name        String
  orderIndex  Int      @default(0)
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  programme CoachingProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  groupAssignments TrainingGroupProgrammeAssignment[]
  gymnastAssignments GymnastProgrammeAssignment[]
  trainingSessions TrainingSession[]

  @@unique([programmeId, name])
  @@index([programmeId, orderIndex, status])
}

model TrainingGroupProgrammeAssignment {
  trainingGroupId String @id
  programmeId String
  stageId String?
  assignedAt DateTime @default(now())
  trainingGroup TrainingGroup @relation(fields: [trainingGroupId], references: [id], onDelete: Cascade)
  programme CoachingProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  stage ProgrammeStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  @@index([programmeId, stageId])
}

model GymnastProgrammeAssignment {
  gymnastId String @id
  programmeId String
  stageId String?
  assignedAt DateTime @default(now())
  gymnast Gymnast @relation(fields: [gymnastId], references: [id], onDelete: Cascade)
  programme CoachingProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  stage ProgrammeStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  @@index([programmeId, stageId])
}

model TrainingSession {
  id                    String   @id @default(cuid())
  organisationId        String
  trainingGroupId       String
  scheduleSlotId        String?
  createdByMembershipId String
  sessionDate           DateTime
  startTime             String
  endTime               String
  title                 String
  sessionIntent         String?
  notes                 String?
  status                String   @default("PLANNED")
  programmeId           String?
  programmeStageId      String?
  programmeNameSnapshot String?
  stageNameSnapshot     String?
  startedAt             DateTime?
  endedAt               DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  trainingGroup TrainingGroup @relation(fields: [trainingGroupId], references: [id], onDelete: Cascade)
  scheduleSlot TrainingGroupSchedule? @relation(fields: [scheduleSlotId], references: [id], onDelete: SetNull)
  createdBy OrganisationMembership @relation(fields: [createdByMembershipId], references: [id], onDelete: Restrict)
  programme CoachingProgramme? @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  programmeStage ProgrammeStage? @relation(fields: [programmeStageId], references: [id], onDelete: SetNull)
  blocks SessionBlock[]
  gymnasts TrainingSessionGymnast[]
  facilityAssignment TrainingSessionFacility?

  @@index([organisationId, sessionDate])
  @@index([trainingGroupId, sessionDate])
  @@index([createdByMembershipId, sessionDate])
}

model TrainingSessionGymnast {
  sessionId  String
  gymnastId  String
  source     String   @default("GROUP")
  assignedAt DateTime @default(now())

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  gymnast Gymnast @relation(fields: [gymnastId], references: [id], onDelete: Cascade)

  @@id([sessionId, gymnastId])
  @@index([gymnastId, assignedAt])
}

model SessionBlock {
  id             String   @id @default(cuid())
  sessionId      String
  title          String
  category       String
  apparatus      String?
  durationMin    Int?
  groupObjective String?
  notes          String?
  orderIndex     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  spaceAssignment SessionBlockSpace?
  resourceAssignments SessionBlockResource[]

  @@index([sessionId, orderIndex])
}

model FacilityLocation {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  notes          String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  spaces TrainingSpace[]
  groupPreferences TrainingGroupFacility[]
  sessionAssignments TrainingSessionFacility[]

  @@unique([organisationId, name])
  @@index([organisationId, status])
}

model TrainingSpace {
  id         String   @id @default(cuid())
  locationId String
  name       String
  capacity   Int?
  shareable  Boolean  @default(true)
  notes      String?
  status     String   @default("ACTIVE")
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  location FacilityLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  resources FacilityResource[]
  blockAssignments SessionBlockSpace[]

  @@unique([locationId, name])
  @@index([locationId, orderIndex, status])
}

model FacilityResource {
  id              String   @id @default(cuid())
  trainingSpaceId String
  name            String
  category        String
  quantity        Int      @default(1)
  capacity        Int      @default(1)
  availability    String   @default("AVAILABLE")
  setupNotes      String?
  status          String   @default("ACTIVE")
  orderIndex      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trainingSpace TrainingSpace @relation(fields: [trainingSpaceId], references: [id], onDelete: Cascade)
  blockAssignments SessionBlockResource[]

  @@unique([trainingSpaceId, name])
  @@index([trainingSpaceId, category, status])
}

model TrainingGroupFacility {
  trainingGroupId String @id
  locationId      String
  assignedAt      DateTime @default(now())

  trainingGroup TrainingGroup @relation(fields: [trainingGroupId], references: [id], onDelete: Cascade)
  location FacilityLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
}

model TrainingSessionFacility {
  sessionId  String @id
  locationId String
  assignedAt DateTime @default(now())

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  location FacilityLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
}

model SessionBlockSpace {
  blockId         String @id
  trainingSpaceId String
  assignedAt      DateTime @default(now())

  block SessionBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  trainingSpace TrainingSpace @relation(fields: [trainingSpaceId], references: [id], onDelete: Cascade)

  @@index([trainingSpaceId])
}

model SessionBlockResource {
  blockId    String
  resourceId String
  quantity   Int @default(1)
  assignedAt DateTime @default(now())

  block SessionBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  resource FacilityResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([blockId, resourceId])
  @@index([resourceId])
}

model RulesetProgram {
 id String @id @default(cuid())
 code String @unique
 name String
 governingBody String
 discipline String @default("WAG")
 status String @default("ACTIVE")
 sourceUrl String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 levels RulesetLevel[]
 organisationAssignments OrganisationRulesetAssignment[]
 gymnastAssignments GymnastRulesetAssignment[]
 packages RulesetPackage[]
 @@index([governingBody, discipline, status])
}
model RulesetLevel {
 id String @id @default(cuid())
 programId String
 code String
 name String
 orderIndex Int @default(0)
 status String @default("ACTIVE")
 notes String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 program RulesetProgram @relation(fields:[programId],references:[id],onDelete:Cascade)
 gymnastAssignments GymnastRulesetAssignment[]
 @@unique([programId,code])
 @@index([programId,orderIndex,status])
}
model OrganisationRulesetAssignment {
 organisationId String
 programId String
 enabledAt DateTime @default(now())
 organisation Organisation @relation(fields:[organisationId],references:[id],onDelete:Cascade)
 program RulesetProgram @relation(fields:[programId],references:[id],onDelete:Cascade)
 @@id([organisationId,programId])
 @@index([programId])
}
model GymnastRulesetAssignment {
 gymnastId String @id
 programId String
 levelId String?
 assignedAt DateTime @default(now())
 gymnast Gymnast @relation(fields:[gymnastId],references:[id],onDelete:Cascade)
 program RulesetProgram @relation(fields:[programId],references:[id],onDelete:Cascade)
 level RulesetLevel? @relation(fields:[levelId],references:[id],onDelete:SetNull)
 @@index([programId,levelId])
}

model RulesetPackage {
 id String @id @default(cuid())
 programId String
 code String @unique
 name String
 cycleLabel String
 versionLabel String
 effectiveDate DateTime
 sourceDocument String
 sourceUrl String?
 sourcePublishedAt DateTime?
 status String @default("ACTIVE")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 program RulesetProgram @relation(fields:[programId],references:[id],onDelete:Cascade)
 vaults FigVaultDefinition[]
 elements FigElementDefinition[]
 apparatusRules RulesetApparatusRule[]
 @@index([programId,effectiveDate,status])
}
model FigVaultDefinition {
 id String @id @default(cuid())
 packageId String
 officialNumber String
 variantKey String @default("a")
 groupNumber Int
 name String
 aliases String @default("[]")
 dValue Float
 secondFlightDirection String @default("NON_SALTO")
 doubleSalto Boolean @default(false)
 status String @default("ACTIVE")
 package RulesetPackage @relation(fields:[packageId],references:[id],onDelete:Cascade)
 @@unique([packageId,officialNumber,variantKey])
 @@index([packageId,groupNumber,status])
}

model FigElementDefinition {
 id String @id @default(cuid())
 packageId String
 apparatus String
 officialNumber String
 variantKey String @default("a")
 name String
 aliases String @default("[]")
 difficulty String?
 groupCode String
 groupName String
 sourcePage Int?
 metadata String @default("{}")
 verificationStatus String @default("NEEDS_REVIEW")
 status String @default("ACTIVE")
 package RulesetPackage @relation(fields:[packageId],references:[id],onDelete:Cascade)
 @@unique([packageId,apparatus,officialNumber,variantKey])
 @@index([packageId,apparatus,groupCode,status])
}
model RulesetApparatusRule {
 id String @id @default(cuid())
 packageId String
 apparatus String
 levelCode String @default("ALL")
 ruleType String
 ruleKey String
 valueJson String
 sourcePage Int?
 verificationStatus String @default("NEEDS_REVIEW")
 package RulesetPackage @relation(fields:[packageId],references:[id],onDelete:Cascade)
 @@unique([packageId,apparatus,levelCode,ruleKey])
 @@index([packageId,apparatus,levelCode,ruleType])
 @@map("FigApparatusRule")
}
